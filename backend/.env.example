# ---- Runtime ----
NODE_ENV=development            # development | staging | production | test
PORT=3000
API_PREFIX=api/v1
# Production : liste explicite obligatoire, ex. https://app.defactfacile.com,https://defactfacile.com
CORS_ORIGINS=*
LOG_LEVEL=log

# ---- Supabase (server-side only, NEVER ship these to Flutter) ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- Email ----
RESEND_API_KEY=
EMAIL_FROM="DEFACT FACILE <no-reply@defactfacile.com>"

# ---- AI (provider-agnostic gateway) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=anthropic

# ---- Integrations ----
WHATSAPP_API_KEY=
FNE_API_URL=
FNE_API_KEY=

# ---- Security ----
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
